# Copia este archivo como .env (en la carpeta mobile/) y ajusta los valores.
# Después de cambiarlo, reinicia Expo con: npx expo start -c

# URL de la API .NET de Vaneza, SIN /api al final.
#  - Teléfono físico con Expo Go: la IP de tu computadora en la red Wi-Fi (ipconfig / ifconfig).
#  - Emulador de Android: http://10.0.2.2:5080
#  - Simulador de iOS: http://localhost:5080
EXPO_PUBLIC_API_URL=http://192.168.1.50:5080

# false = usa la API real de arriba.  true = usa la API simulada (no necesita backend).
# Si no defines EXPO_PUBLIC_API_URL, la app arranca en modo simulado.
EXPO_PUBLIC_USAR_MOCK=false
